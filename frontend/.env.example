# Base URL of the Laravel API (no trailing slash).
# Copy this file to .env.local and adjust as needed.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# AI providers — fill one in .env.local to enable live AI calls (fallback = mock templates)
# GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=google/gemini-2.0-flash-001
